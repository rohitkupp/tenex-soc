# =============================================================================
# Tenex SOC Analyst — local environment
# =============================================================================
#
# HOW TO USE THIS FILE
#
#   cp .env.example .env
#   # then edit .env and set ANTHROPIC_API_KEY (the only value you must provide)
#
# `docker compose` (and therefore every `make` target) reads `.env` from this
# directory automatically. You do not need to export anything into your shell.
#
# Every value below already has a working local default except ANTHROPIC_API_KEY.
# Copy the file, paste your key, and the rest can stay exactly as it ships.
#
# Nothing here is a real credential. The placeholder secrets are local-only and
# are deliberately rejected if you ever set ENVIRONMENT to anything but `local`
# (see backend/app/core/config.py `_reject_dev_secrets_outside_local`).
#
# Full walkthrough: LOCAL_SETUP.md
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED — Anthropic API key
# -----------------------------------------------------------------------------
# This is the one value you must fill in. Get a key at https://console.anthropic.com/
# (API Keys -> Create Key). It looks like `sk-ant-api03-...`.
#
# It must be an ANTHROPIC API KEY with credit on the account. A Claude.ai Pro or
# Max subscription is a different product and grants no API access.
#
# What breaks without it: the pipeline still ingests, parses, detects and
# correlates — you will get incidents, signals, evidence and a working UI — but
# agentic triage fails, so incidents have no LLM narrative, disposition or ATT&CK
# mapping. There is no offline/canned fallback: DEMO_MODE was removed in the v2
# migration precisely so that cost and latency are visible rather than faked.
#
# Cost, measured rather than guessed: triage averages ~$1.40 and ~3 minutes PER
# INCIDENT. What a run costs is therefore set by how many incidents the uploaded
# log produces, capped by MAX_TRIAGE_INCIDENTS below. The recommended demo log
# (backend/data/demo5_tiny/scenario_c2_beaconing.log) is 100 lines and produces
# only a handful of incidents, so a first run is a few dollars and a few minutes.
# The much larger data/samples/01-mixed-week.log produces 27 incidents and costs
# ~$20 / 30-45 minutes at a cap of 15.
#
# The test suite replays recorded fixtures, so `make test` never needs a key.
ANTHROPIC_API_KEY=

# Leave this as claude-sonnet-5. That is the model this project was built and
# measured against, and it is the cheaper of the two ids the app accepts.
#
# Only two are valid — the keys of `_MODEL_RATES` in backend/app/agent/client.py,
# which carries per-model pricing; anything else raises rather than silently
# guessing what a token costs:
#
#   claude-sonnet-5   $3 / $15 per Mtok    <- use this
#   claude-opus-5     $5 / $25 per Mtok    <- roughly doubles the cost per incident
ANTHROPIC_MODEL=claude-sonnet-5


# -----------------------------------------------------------------------------
# 2. Cost ceilings on the LLM layer
# -----------------------------------------------------------------------------
# The hard cap on how many incidents get sent for agentic triage per analysis,
# and by far the biggest lever on what a run costs and how long it takes
# (~$1.40 and ~3 minutes each). Incidents are ranked by fused score first, so
# lowering this keeps the most severe ones and drops the tail.
#
# It is a CAP, not a target: a run triages whichever is smaller — this number, or
# however many incidents the upload actually produced. The recommended demo log
# (backend/data/demo5_tiny/scenario_c2_beaconing.log) produces only a handful, so
# 10 leaves headroom without ever spending ten incidents' worth on it.
#
#   10 -> shipped here; ample headroom for the recommended demo log
#   15 -> the application's own default, sized for the far larger data/samples/
#         logs (~$20 and 30-45 minutes on 01-mixed-week.log)
#
# Check your credit balance before pointing this at a large log. If the account
# runs out of credit mid-run, the triage stage takes a non-retryable HTTP 400 and
# the WHOLE analysis is marked failed — verdicts already produced are kept and
# stay browsable, but the run does not resume by itself.
MAX_TRIAGE_INCIDENTS=10

# Max tool calls a single triage agent may make before it is cut off.
AGENT_MAX_TOOL_CALLS=8

# Per-incident wall-clock budget across the whole Analyst -> Judge -> Presenter
# chain (not per call). Below ~300 a slow generation late in the chain can abort
# an incident that already paid for its earlier calls.
AGENT_TIMEOUT_SECONDS=300


# -----------------------------------------------------------------------------
# 3. Security — fine as-is for local, must change before any deployment
# -----------------------------------------------------------------------------
# These placeholders only work while ENVIRONMENT=local (the default). Booting
# with ENVIRONMENT=staging or =production while any of them is still at its
# default raises at startup instead of running an app whose JWTs anyone can forge.
#
# Generate real values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

JWT_SECRET=dev-only-insecure-change-me
JWT_TTL_MINUTES=60

# Per-tenant salt for HMAC pseudonymization. Never logged, never leaves the
# tenant boundary, never enters a prompt.
PSEUDONYM_SALT=dev-only-insecure-salt

# Deliberately SHARED across tenants — it is the one salt in the system that is
# not per-tenant, because cross-tenant indicator overlap has to be detectable.
# See backend/app/tier2/__init__.py for the tradeoff.
TIER2_INDICATOR_SALT=dev-only-insecure-shared-indicator-salt

# Password for the dedicated SELECT-only `tier2_readonly` Postgres role. Read by
# both the Alembic migration that provisions the role and by
# app/tier2/readonly_db.py that connects as it, so the two cannot drift.
TIER2_READONLY_DB_PASSWORD=dev-only-insecure-tier2-readonly-password


# -----------------------------------------------------------------------------
# 4. Demo login — optional
# -----------------------------------------------------------------------------
# `make seed` creates one user. Leave these unset to get the documented defaults:
#
#     email:    demo@tenex.local
#     password: tenex-demo-password
#
# Uncomment to override. If you change them AFTER running `make seed`, re-running
# seed creates an additional user rather than updating the existing one.
# SEED_USER_EMAIL=demo@tenex.local
# SEED_USER_PASSWORD=tenex-demo-password


# -----------------------------------------------------------------------------
# 5. Email verification — optional, leave blank for local
# -----------------------------------------------------------------------------
# Supabase Auth is used for exactly one thing: proving someone controls an email
# address at signup. It is NOT the identity provider — this app keeps its own
# users, argon2id password hashes, JWTs and tenant binding either way.
#
# Leave both blank (the default) and email verification is simply disabled:
# `POST /api/auth/signup` marks new accounts verified immediately and the API
# logs a warning saying so. That is what makes a fresh `make up` work with no
# Supabase project at all. You do not need this to review the application.
#
# `GET /api/health` reports `email_verification_enabled` so this mode is visible
# from the outside rather than only in the logs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where Supabase sends the browser after the verification link is clicked.
# Only read when the two values above are set.
FRONTEND_BASE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 6. Frontend wiring — the defaults are correct for docker compose
# -----------------------------------------------------------------------------
# Leave NEXT_PUBLIC_API_URL EMPTY (or commented out) for the compose setup.
#
# Empty means the browser talks to /api/* on its own origin (localhost:3000) and
# Next.js proxies through to the API — the same first-party-cookie path the
# deployed build uses. Setting it to http://localhost:8000 makes the browser call
# the API directly instead; that also works locally (both are same-site on
# localhost, so the Lax session cookie is still sent) but it exercises a
# different path than production does, and it depends on CORS_ORIGINS below.
#
# NEXT_PUBLIC_API_URL=

# Origins the API will accept browser requests from. Only consulted on the
# direct-to-API path above. Comma-separated; a plain comma string is parsed
# correctly (`Annotated[list[str], NoDecode]` in backend/app/core/config.py).
CORS_ORIGINS=http://localhost:3000

# Where the web container reaches the API from INSIDE the docker network. This
# must be the compose service name, not localhost — inside that container
# `localhost` is the web container itself. Baked in at image build time because
# Next's `output: "standalone"` serialises rewrites into the build manifest, so
# changing it means rebuilding the web image (`make up` does that for you).
API_ORIGIN=http://api:8000


# -----------------------------------------------------------------------------
# 7. Misc
# -----------------------------------------------------------------------------
# `local` is what keeps the placeholder secrets above acceptable and selects the
# Lax / non-Secure session cookie pair that plain-HTTP localhost requires.
ENVIRONMENT=local

# debug | info | warning | error. `debug` is useful for watching a stage-by-stage
# pipeline run in `make logs`.
LOG_LEVEL=info
