# Copy to .env and fill in. `make up` reads this file.
# Nothing here is a real credential — the defaults are local-only.

# --- Required for the agent layer (M11+). Everything else runs without it. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Security. Generate real values before deploying anywhere. ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-change-me
JWT_TTL_MINUTES=60
# Per-tenant salt for HMAC pseudonymization. Never logged, never leaves the tenant boundary.
PSEUDONYM_SALT=dev-only-insecure-salt

# --- Cost ceilings on the LLM layer ---
MAX_TRIAGE_INCIDENTS=15
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=120

# Serve precomputed verdicts instead of calling the API. Used by the deployed demo.
DEMO_MODE=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
