# Copy to .env and fill in. `make up` reads this file.
# Nothing here is a real credential — the defaults are local-only.

# --- Required for the agent layer (M11+). Everything else runs without it. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Security. Generate real values before deploying anywhere. ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-change-me
JWT_TTL_MINUTES=60
# Per-tenant salt for HMAC pseudonymization. Never logged, never leaves the tenant boundary.
PSEUDONYM_SALT=dev-only-insecure-salt
# Tier 2 (M14): deliberately SHARED across tenants so cross-tenant indicator overlap is
# detectable -- see backend/app/tier2/__init__.py. Every other salt above is per-tenant;
# this one is not, by design.
TIER2_INDICATOR_SALT=dev-only-insecure-shared-indicator-salt
# Password for the dedicated SELECT-only `tier2_readonly` Postgres role the NL->SQL
# chatbot connects as (docs/06 "Text-to-SQL safety"). Generate a real value before
# deploying anywhere -- same idea as JWT_SECRET above.
TIER2_READONLY_DB_PASSWORD=dev-only-insecure-tier2-readonly-password

# --- Cost ceilings on the LLM layer ---
MAX_TRIAGE_INCIDENTS=15
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=120

# Serve precomputed verdicts instead of calling the API. Used by the deployed demo.
DEMO_MODE=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
