# =============================================================================
# Frontend environment — OPTIONAL
# =============================================================================
#
# You do NOT need this file for the normal setup. `docker compose` supplies both
# variables below to the `web` container from the ROOT `.env` file, so the
# documented path in LOCAL_SETUP.md never touches this one.
#
# Use it only if you want to run the Next.js dev server directly on your host
# (hot reload, React DevTools) while the backend stays in Docker:
#
#   cd frontend
#   cp .env.example .env.local
#   npm install
#   npm run dev            # http://localhost:3000
#
# Both variables already default to the values below in code, so an empty file
# behaves identically — they are written out here to make the two-origin split
# explicit rather than implicit.
# =============================================================================


# Server-side only. Where the Next.js server process reaches the API: the
# `/api/*` rewrite target in next.config.ts and the base URL used by
# middleware.ts and lib/api/server.ts.
#
# Running on your HOST, the API is published on localhost:8000:
API_ORIGIN=http://localhost:8000
#
# Running INSIDE docker compose it must be the service name instead, because
# `localhost` in that container is the web container itself:
#   API_ORIGIN=http://api:8000
#
# Note: with `output: "standalone"` Next serialises rewrites into the build
# manifest, so in a Docker BUILD this must be a build arg, not a runtime env
# var. `npm run dev` on the host reads it at runtime normally.


# Browser-facing. Leave EMPTY so the browser calls /api/* on its own origin and
# the Next server proxies to API_ORIGIN — this keeps the session cookie
# first-party, which is what the deployed build depends on.
#
# Set it to http://localhost:8000 only if you want the browser to call the API
# directly, which additionally requires CORS_ORIGINS to include
# http://localhost:3000 in the root .env.
NEXT_PUBLIC_API_URL=
